{
  "name": "afisare-drutu",
  "productName": "Afișare Druțu",
  "version": "1.0.4",
  "description": "Control pentru panoul LED de pe clădire: playlist, programare pe zile, YouTube, Canva, luminozitate.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "ro.drutu.afisare",
    "productName": "Afișare Druțu",
    "files": [
      "server.js",
      "public/**",
      "desktop/**",
      "!public/uploads/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Afișare Druțu"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon-1024.png",
      "category": "public.app-category.business"
    },
    "artifactName": "Afisare-Drutu-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Afișare Druțu",
  "repository": {
    "type": "git",
    "url": "https://github.com/gheorgheturcu97-eng/afisare-drutu.git"
  }
}